# ── Storage ──────────────────────────────────────────────────────────────────
# Neon Postgres pooled connection string. Required in production.
# Local development needs nothing here — the JSON file store under .data/ is
# used automatically.
DATABASE_URL=

# Escape hatch for verifying a production build with no database, locally or in
# CI. Never set this on the real deployment: it permits a file store that the
# read-only serverless filesystem will silently discard.
# ALLOW_FILE_STORE=1

# ── Auth ─────────────────────────────────────────────────────────────────────
# argon2id hash of the shared owner password. Never the password itself.
# Generate with:  npm run hash-password -- 'the password'
#
# IMPORTANT — dollar signs. An argon2 hash is full of them, and a .env file
# treats `$name` as a variable reference and expands it away, even inside
# quotes. Pasted raw into a .env file the hash silently arrives as fragments
# and every sign-in fails with "that password does not match" while the
# password is perfectly correct. So:
#
#   In a .env file      escape every $ as \$   (the script prints this form)
#   In Vercel's UI      paste the hash as-is   (values are stored literally)
#
# The app refuses to accept a hash that does not start with $argon2 and says
# why, so a mangled value fails loudly rather than looking like a typo.
OWNER_PASSWORD_HASH=

# Signing key for the session cookie. 32+ characters.
# Generate with:  openssl rand -base64 32
SESSION_SECRET=

# ── Email (phase 4) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
